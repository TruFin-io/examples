# Mainnet RPC endpoint (use your own provider; the public one is heavily rate-limited).
RPC_URL=https://api.mainnet-beta.solana.com

# Path to a Solana CLI keypair JSON file. Supports ~ (home), relative, and absolute paths.
WALLET_KEYPAIR=~/.config/solana/id.json

# Optional: set to 1 to simulate transactions (dry-run, logs only) instead of sending them.
# SIMULATE=1
